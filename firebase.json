{
  "functions": {
    "source": "functions",
    "runtime_options": {
      "env_vars": {
        "POSTS_COLLECTION": "posts-iteration-1.0",
        "QUERIES_COLLECTION": "toxic-queries-test",
        "EMAIL_COLLECTION": "mail",
        "EMAIL_RECIPIENTS": "test@maam.ai, test2@maam.ai",
        "EMAIL_SUBJECT": "Toxic Content Alert - Action Required",
        "EMAIL_BODY": "A document has been flagged as toxic content in the system. Please review it as soon as possible."
      }
    }
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "extensions": {
    "firestore-send-email": "firebase/firestore-send-email@0.1.27"
  }
}